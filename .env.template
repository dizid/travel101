# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (enable in Neon Console > Authentication)
VITE_NEON_AUTH_URL=https://your-project.neon.tech

# Stripe Payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# Claude API (AI features)
ANTHROPIC_API_KEY=sk-ant-xxx

# Shared secret speed bump on AI endpoints (ai, packing, attraction-ai) — must match
# between server (APP_SHARED_SECRET, no VITE_ prefix) and client (VITE_APP_SHARED_SECRET).
# Fails open if unset, so this is optional for local dev. See AI-COST-RISK.md.
APP_SHARED_SECRET=your-shared-secret
VITE_APP_SHARED_SECRET=your-shared-secret

# Affiliate Partner IDs (for commission tracking)
VITE_KLOOK_AFFILIATE_ID=your_klook_id
VITE_AGODA_AFFILIATE_ID=your_agoda_id
VITE_12GO_AFFILIATE_ID=your_12go_id
VITE_GETYOURGUIDE_AFFILIATE_ID=your_getyourguide_id
VITE_VIATOR_AFFILIATE_ID=your_viator_partner_id
VITE_SAFETYWING_AFFILIATE_ID=your_safetywing_id
VITE_NORDVPN_AFFILIATE_ID=your_nordvpn_referral_code
